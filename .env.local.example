# Copy this file to .env.local and fill in real values.
# Get these from your Supabase project settings -> API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key is SECRET - server-side only, never exposed to the browser.
# Only needed for admin-only server actions/routes.
SUPABASE_SERVICE_ROLE_KEY=

# Used for sitemap.xml, robots.txt, and Open Graph tags. Set this to the
# real domain once deployed (Phase 26), e.g. https://bysimongifts.com.ng
# Leave unset during local development - it defaults to localhost.
NEXT_PUBLIC_SITE_URL=
